# Comma-separated production origins. Local development is allowed by default.
CLIENT_ORIGIN=https://your-frontend.example.com
PORT=3001
DATABASE_PATH=./data/little-world.sqlite
# A TURN service is strongly recommended for calls across restrictive mobile networks.
VITE_STUN_URL=stun:stun.l.google.com:19302
